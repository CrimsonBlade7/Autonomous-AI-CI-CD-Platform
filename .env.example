# GitHub Configuration
GITHUB_TOKEN=github_pat_...
GITHUB_REPOSITORY_URL=https://github.com/....git
GITHUB_WEBHOOK_SECRET=meat

# AI Engine Configuration
INTERNAL_SECRET=secret
AI_ENGINE_URL=http://ai-service:8000
AI_ENGINE_REQUEST_CLOSE_TIMEOUT=30

# Server Configuration
PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10
READ_HEADER_TIMEOUT=5
WRITE_TIMEOUT=15
REQUEST_TIMEOUT=30

# Execution and Resource Constraints
MAX_TEST_PATCHING_ATTEMPTS=3

# Docker Constraints
DOCKER_START_TIMEOUT=10
CONTAINER_TIMEOUT=60
CONTAINER_MEMORY_CAP=512

# PostgreSQL — overridden by docker-compose's environment: block for the
# ai-engine/celery-worker services; only needed for running outside Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiplatform

# Redis — used as Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# Gemini API key — used by the patch generator.
GEMINI_API_KEY=apikey123

# Orchestrator callback — where to POST AIEngineResponse after processing a job.
ORCHESTRATOR_URL=http://host.docker.internal:8080
